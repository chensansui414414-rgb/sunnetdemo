# 中国城市优先数据源代理配置
#
# 注意：SmartWeatherAPI 通常需要 appid/privateKey/sign 等服务端签名信息。
# 不要把密钥放进 NEXT_PUBLIC_* 变量。这里配置的是你自己的服务端代理地址。
#
# 代理建议返回 Open-Meteo 兼容字段：
# {
#   "hourly": {
#     "time": ["2026-07-24T18:00"],
#     "cloud_cover": [55],
#     "cloud_cover_low": [30],
#     "cloud_cover_mid": [40],
#     "cloud_cover_high": [25],
#     "relative_humidity_2m": [68],
#     "visibility": [12000],
#     "precipitation_probability": [20]
#   },
#   "daily": {
#     "sunrise": ["2026-07-24T05:12"],
#     "sunset": ["2026-07-24T19:05"]
#   }
# }
NEXT_PUBLIC_CHINA_WEATHER_PROXY_URL=

# 生态环境部空气质量代理。优先返回 aerosol_optical_depth；
# 如果暂时只有 pm25/pm10/aqi，前端会明确标记为“PM/AQI 推导 AOD”。
NEXT_PUBLIC_MEE_AIR_PROXY_URL=
