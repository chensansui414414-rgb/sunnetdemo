# 中国城市优先数据源代理配置
#
# 当前项目已内置 /api/qweather，会在服务端调用和风天气 24 小时逐小时预报。
# 不要把 QWEATHER_API_KEY 放进 NEXT_PUBLIC_* 变量。
#
# 如果未来改成独立 SmartWeatherAPI 或其他代理，可在这里覆盖。
# 代理建议返回 Open-Meteo 兼容字段：
# {
#   "hourly": {
#     "time": ["2026-07-24T18:00"],
#     "cloud_cover": [55],
#     "cloud_cover_low": [30],
#     "cloud_cover_mid": [40],
#     "cloud_cover_high": [25],
#     "relative_humidity_2m": [68],
#     "visibility": [12000],
#     "precipitation_probability": [20]
#   },
#   "daily": {
#     "sunrise": ["2026-07-24T05:12"],
#     "sunset": ["2026-07-24T19:05"]
#   }
# }
NEXT_PUBLIC_CHINA_WEATHER_PROXY_URL=

QWEATHER_API_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com

# 生态环境部空气质量代理。
# 当前项目已内置 /api/mee-air，会请求 air.cenmc.cn:18007 的城市级空气质量网页接口。
# 如未来改成独立代理服务，可在这里覆盖。
NEXT_PUBLIC_MEE_AIR_PROXY_URL=

# AOD 优先源：
# 当前项目已内置 /api/aeronet，会请求 AERONET Version 3 Level 2.0 Direct Sun AOD。
# 前端优先级：AERONET 实测 AOD > 生态环境部 PM/AQI 推导 AOD > Open-Meteo AOD。
